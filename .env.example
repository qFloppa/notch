# Notch demo configuration. Copy to `.env` and fill in.
#
# `deploy/deploy.py` prints all three of these ready to paste. `.env` itself is
# gitignored; this example is not, which is why `.gitignore` carries an explicit
# `!.env.example` negation beside its `.env*` rule.

# The deployed contract both agents talk to.
NOTCH_ADDRESS=0x266a61216466477ADF4dcFdAd09972Eb64DaCEd8

# The two demo identities. Generated by deploy/deploy.py, which also funds them.
# studionet is gasless, so these need no faucet — but the dispute bond is real
# attached value, so the buyer does need a balance.
#
# These are throwaway keys for a hosted test network. Never put a key with real
# value in a file next to a repo.
SELLER_KEY=0x...
BUYER_KEY=0x...

# Only read on a localnet or GLSim run, where exec_prompt runs locally.
# studionet resolves disputes on its own hosted validators, so the demo needs
# no model key at all.
OPENAI_API_KEY=

# --- public testnet, optional -------------------------------------------------
# Only needed for `deploy/deploy.py --network bradbury`. Gas is real there, so
# this address must be funded first at
# https://testnet-faucet.genlayer.foundation/ -- 100 GEN per 24h, and it has to
# be claimed in a browser because the faucet is behind Cloudflare Turnstile.
#
# Bradbury and Asimov are the same chain (id 4221, identical block hashes), so
# one funded key covers both. BRADBURY_ADDRESS is just the deployer account this
# key derives to, kept here so you can paste it into the faucet and the explorer;
# only BRADBURY_KEY is read by the code. The *contract* address is in README.md.
BRADBURY_ADDRESS=0x...
BRADBURY_KEY=0x...
